# Пример файла настроек.
# Скопируйте его в .env и укажите реальный пароль:
#   Copy-Item .env.example .env
# Файл .env в Git не попадает.

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mini_monitoring

# Как часто планировщик просыпается, секунды
CHECK_TICK_SECONDS=5

# Сколько дней хранить историю проверок
RETENTION_DAYS=30

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
